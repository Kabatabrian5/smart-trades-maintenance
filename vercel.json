{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/bot-builder/:path*",
      "destination": "/bot-builder/:path*"
    },
    {
      "source": "/((?!bot-builder|assets|static|sw\.js|offline\.html).*)",
      "destination": "/index.html"
    }
  ]
}
